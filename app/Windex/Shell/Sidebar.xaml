<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar (design §6): hosts → sessions → tabs, a Tailnet group, and an Add host footer. -->
<UserControl
    x:Class="Windex.Shell.Sidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="Rows"
            Padding="8,4,8,8"
            AutomationProperties.Name="Hosts and sessions"
            IsItemClickEnabled="True"
            ItemClick="Rows_ItemClick"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1,0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
        </ListView>

        <StackPanel
            x:Name="EmptyState"
            Margin="24,0,24,48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                FontSize="32"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE968;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="No hosts yet" />
            <!-- The workspace's first-run card and the footer below carry the Add host buttons. -->
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Hosts you add appear here with their sessions and tabs."
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Padding="8,0,8,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Button
                x:Name="AddHostButton"
                Height="32"
                Padding="8,0,10,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Add host"
                Click="AddHost_Click"
                Style="{StaticResource RexSubtleButtonStyle}"
                ToolTipService.ToolTip="Add a Rex host">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock FontSize="13" Text="Add host" />
                </StackPanel>
            </Button>
            <Button
                x:Name="FooterMore"
                Width="32"
                Height="32"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="More host actions"
                Content="&#xE712;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="14"
                Style="{StaticResource RexSubtleButtonStyle}"
                ToolTipService.ToolTip="More">
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuFlyoutItem Click="Refresh_Click" Text="Refresh hosts">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="Manage_Click" Text="Manage hosts…">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</UserControl>
