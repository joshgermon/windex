<?xml version="1.0" encoding="utf-8"?>
<!-- The Windex window (design §3): a 48 epx title row (sidebar toggle, identity chip, glass pill
     tabs, actions, system caption buttons), the sidebar, and pane cards on the window ground. -->
<Window
    x:Class="Windex.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:panes="using:Windex.Panes"
    xmlns:shell="using:Windex.Shell"
    Title="Windex">

    <Grid
        x:Name="Root"
        Background="{ThemeResource RexGroundBrush}"
        PreviewKeyDown="Root_PreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRowDefinition" Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The ground: backdrop (Window.SystemBackdrop) + aurora wash. -->
        <Rectangle
            x:Name="Aurora"
            Grid.RowSpan="2"
            Fill="{ThemeResource RexAuroraBrush}"
            IsHitTestVisible="False" />
        <Rectangle
            x:Name="AccentTint"
            Grid.RowSpan="2"
            Fill="{ThemeResource RexAccentTintBrush}"
            IsHitTestVisible="False"
            Opacity="0.3"
            Visibility="Collapsed" />

        <!-- ============================== Title row ============================== -->
        <Grid x:Name="TitleRow" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="CaptionInset" Width="138" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="SidebarToggle"
                Grid.Column="1"
                AutomationProperties.AcceleratorKey="Ctrl+Shift+B"
                AutomationProperties.Name="Toggle sidebar"
                Click="SidebarToggle_Click"
                Content="&#xE90C;"
                Style="{StaticResource RexTitleBarButtonStyle}"
                ToolTipService.ToolTip="Toggle sidebar (Ctrl+Shift+B)" />

            <Button
                x:Name="IdentityChip"
                Grid.Column="3"
                AutomationProperties.AcceleratorKey="Ctrl+Shift+K"
                Click="IdentityChip_Click"
                Style="{StaticResource RexIdentityChipStyle}"
                ToolTipService.ToolTip="Switch session (Ctrl+Shift+K)">
                <Grid ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="ChipGlyphHost"
                        Width="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                    <StackPanel
                        x:Name="ChipText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            x:Name="ChipSession"
                            FontSize="13"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="Windex"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="ChipHost"
                            Margin="0,-1,0,0"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE70D;" />
                </Grid>
            </Button>

            <!-- Rex Mac's tab track: one rounded band behind the pills (sized in MainWindow.TitleBar.cs). -->
            <Border
                x:Name="TabTrack"
                Grid.Column="5"
                Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{ThemeResource RexTabTrackBrush}"
                CornerRadius="12"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <TabView
                x:Name="Tabs"
                Grid.Column="5"
                Height="48"
                Padding="0"
                VerticalAlignment="Center"
                AddTabButtonClick="Tabs_AddTabButtonClick"
                AllowDropTabs="True"
                AutomationProperties.Name="Tabs"
                CanDragTabs="True"
                CanReorderTabs="True"
                CloseButtonOverlayMode="OnPointerOver"
                IsAddTabButtonVisible="True"
                SelectionChanged="Tabs_SelectionChanged"
                TabCloseRequested="Tabs_TabCloseRequested"
                TabDragCompleted="Tabs_TabDragCompleted"
                TabWidthMode="Equal">
                <TabView.Resources>
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
                    <x:Double x:Key="TabViewItemMaxWidth">240</x:Double>
                    <x:Double x:Key="TabViewItemMinWidth">120</x:Double>
                    <x:Double x:Key="TabViewItemAddButtonWidth">32</x:Double>
                    <x:Double x:Key="TabViewItemAddButtonHeight">32</x:Double>
                    <Thickness x:Key="TabViewItemAddButtonContainerPadding">2,8,0,8</Thickness>
                    <Thickness x:Key="TabViewItemLeftScrollButtonContainerPadding">0,8,2,8</Thickness>
                    <Thickness x:Key="TabViewItemRightScrollButtonContainerPadding">2,8,0,8</Thickness>
                    <Thickness x:Key="TabViewHeaderPadding">0</Thickness>
                    <StaticResource x:Key="TabViewButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="TabViewButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="TabViewButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="TabViewButtonForeground" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="TabViewButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                </TabView.Resources>
                <TabView.TabStripFooter>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="48" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="NewItemMenu"
                            Width="28"
                            Height="32"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="New"
                            Content="&#xE70D;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource RexSubtleButtonStyle}"
                            ToolTipService.ToolTip="New tab, session, split or host">
                            <Button.Flyout>
                                <MenuFlyout x:Name="NewItemFlyout" Placement="BottomEdgeAlignedLeft" />
                            </Button.Flyout>
                        </Button>
                        <Grid x:Name="TabDragSpace" Grid.Column="1" />
                    </Grid>
                </TabView.TabStripFooter>
            </TabView>

            <StackPanel
                x:Name="Actions"
                Grid.Column="6"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="ActivityButton"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+A"
                    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                    AutomationProperties.Name="Activity"
                    Click="ActivityButton_Click"
                    Style="{StaticResource RexTitleBarButtonStyle}"
                    ToolTipService.ToolTip="Activity (Ctrl+Shift+A)">
                    <Grid>
                        <FontIcon FontSize="16" Glyph="&#xEA8F;" />
                        <InfoBadge
                            x:Name="ActivityBadge"
                            Margin="0,-6,-9,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button
                    x:Name="SearchButton"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+P"
                    AutomationProperties.Name="Search sessions and commands"
                    Click="SearchButton_Click"
                    Content="&#xE721;"
                    Style="{StaticResource RexTitleBarButtonStyle}"
                    ToolTipService.ToolTip="Search sessions and commands (Ctrl+Shift+K · Ctrl+Shift+P)" />
                <Button
                    x:Name="MoreActionsButton"
                    AutomationProperties.Name="More"
                    Content="&#xE712;"
                    Style="{StaticResource RexTitleBarButtonStyle}"
                    ToolTipService.ToolTip="More"
                    Visibility="Collapsed">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Click="ActivityMenuItem_Click" Text="Activity">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA8F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="SearchButton_Click" Text="Search sessions and commands">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE721;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="SettingsButton"
                    AutomationProperties.AcceleratorKey="Ctrl+,"
                    AutomationProperties.Name="Settings"
                    Click="SettingsButton_Click"
                    Content="&#xE713;"
                    Style="{StaticResource RexTitleBarButtonStyle}"
                    ToolTipService.ToolTip="Settings (Ctrl+,)" />
            </StackPanel>
        </Grid>

        <!-- Full screen: resting at the top edge reveals the title row as an overlay. -->
        <Border
            x:Name="FullScreenHotZone"
            Grid.Row="1"
            Height="6"
            VerticalAlignment="Top"
            Background="Transparent"
            PointerEntered="FullScreenHotZone_PointerEntered"
            PointerExited="FullScreenHotZone_PointerExited"
            Visibility="Collapsed" />

        <!-- ============================== Body ============================== -->
        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="SidebarHost">
                <shell:Sidebar x:Name="SidebarView" />
            </Grid>

            <Grid x:Name="Workspace" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="InfoBars" Margin="8,4,8,0" Spacing="6">
                    <InfoBar
                        x:Name="HostInfoBar"
                        AutomationProperties.LiveSetting="Assertive"
                        CloseButtonClick="HostInfoBar_CloseButtonClick"
                        IsOpen="False" />
                </StackPanel>

                <panes:PaneArea x:Name="PaneArea" Grid.Row="1" />

                <!-- First run (no hosts): §9.12 -->
                <Border
                    x:Name="FirstRunCard"
                    Grid.Row="1"
                    Width="480"
                    Padding="32,28,32,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource RexPaneCardBrush}"
                    BorderBrush="{ThemeResource RexPaneStrokeBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RexCardCornerRadius}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="40"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE968;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Connect to a Rex server" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="Windex shows sessions running on your machines. Pick one on your tailnet or add an address."
                            TextAlignment="Center" />
                        <StackPanel
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button
                                Click="AddHost_Click"
                                Content="Add host"
                                Style="{StaticResource AccentButtonStyle}" />
                            <HyperlinkButton Content="Learn about Rex" NavigateUri="https://www.superlogical.com/rex" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hosts but nothing open, or a session without tabs. -->
                <StackPanel
                    x:Name="EmptyWorkspace"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="EmptyWorkspaceGlyph"
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8A9;" />
                    <TextBlock
                        x:Name="EmptyWorkspaceTitle"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="EmptyWorkspaceText"
                        MaxWidth="360"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="EmptyWorkspaceButton"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Click="EmptyWorkspaceButton_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- In-app notices: bottom-right, at most three. -->
                <StackPanel
                    x:Name="Notices"
                    Grid.Row="1"
                    Width="360"
                    Margin="0,0,12,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="8" />
            </Grid>
        </Grid>

        <Popup
            x:Name="PalettePopup"
            Grid.RowSpan="2"
            IsLightDismissEnabled="True"
            ShouldConstrainToRootBounds="True" />

        <!-- First run (§9.12): where hosts are added, once. -->
        <TeachingTip
            x:Name="AddHostTip"
            Title="Add your first host"
            ActionButtonClick="AddHostTip_ActionButtonClick"
            ActionButtonContent="Add host"
            Closed="AddHostTip_Closed"
            CloseButtonContent="Got it"
            PreferredPlacement="TopRight"
            Subtitle="Add a Rex server on your tailnet, over SSH or HTTPS. Its sessions appear in this sidebar, and you can add more hosts here any time.">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE968;" />
            </TeachingTip.IconSource>
        </TeachingTip>

        <!-- Once a session is open (§9.12): the identity chip is the session switcher. -->
        <TeachingTip
            x:Name="SwitcherTip"
            Title="Switch sessions here"
            ActionButtonClick="SwitcherTip_ActionButtonClick"
            ActionButtonContent="Use Ctrl+K instead"
            Closed="SwitcherTip_Closed"
            CloseButtonContent="Got it"
            PreferredPlacement="BottomRight"
            Subtitle="Click the session name, or press Ctrl+Shift+K, to jump to any session on any host or start a new one."
            Target="{x:Bind IdentityChip}">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE8AB;" />
            </TeachingTip.IconSource>
        </TeachingTip>
    </Grid>
</Window>
